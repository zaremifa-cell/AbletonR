{
  "name": "ableton-programme",
  "private": true,
  "version": "1.0.0",
  "description": "A portfolio redesign concept for Ableton, built as a precise React product archive.",
  "author": "Zlatko Anastasov",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:ui": "playwright test e2e/audit.spec.ts --reporter=line --workers=1 --timeout=60000",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lhci": "npx --yes @lhci/cli@latest autorun",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "hooks:install": "husky",
    "optimize:images": "node scripts/optimize-images.mjs",
    "build": "next build",
    "preview": "next start"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,css}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "eslint-config-next": "^16.2.9",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "storybook": "^8.6.18",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  }
}
